{
  "manifestVersion": 1,
  "id": "evotalks.gestao-imoveis",
  "version": "0.1.0",
  "name": "Gerenciamento de Imóveis",
  "description": "Campos internos por imóvel (taxas, encargos, observações) que não aparecem no site, com histórico de autoria e registro de consultas. Porte do portal de taxas do William Imóveis para dentro do EvoTalks.",
  "author": { "name": "Evotalks / Cromyk" },
  "config": [
    {
      "key": "marca",
      "label": "Marca do catálogo (brand)",
      "type": "string",
      "default": "WILLIAM IMÓVEIS BOULEVARD",
      "help": "Filtra o catálogo por este campo brand. Vazio traz todos os produtos."
    },
    {
      "key": "prefixoCodigo",
      "label": "Prefixo do código a esconder",
      "type": "string",
      "default": "535",
      "help": "O código do site não mostra o prefixo da imobiliária (5350060 vira 0060)."
    },
    {
      "key": "rotulo",
      "label": "Como chamar o item do catálogo",
      "type": "string",
      "default": "imóvel",
      "help": "Usado nos textos das telas."
    }
  ],
  "contributions": [
    {
      "id": "gestao-imoveis",
      "type": "topMenu",
      "title": "Gerenciamento de Imóveis",
      "icon": "icon-far-building",
      "visibility": { "userTypes": [0, 1] },
      "presentation": { "mode": "menu" },
      "items": [
        {
          "id": "gi-imoveis",
          "title": "Imóveis",
          "icon": "icon-far-building",
          "url": "app/imoveis.html",
          "presentation": { "mode": "dialog", "size": "lg" }
        },
        {
          "id": "gi-campos",
          "title": "Campos",
          "icon": "icon-far-list",
          "url": "app/campos.html",
          "presentation": { "mode": "dialog", "size": "lg" }
        },
        {
          "id": "gi-historico",
          "title": "Histórico",
          "icon": "icon-far-clock",
          "url": "app/historico.html",
          "presentation": { "mode": "dialog", "size": "lg" }
        },
        {
          "id": "gi-consultas",
          "title": "Consultas",
          "icon": "icon-far-search",
          "url": "app/consultas.html",
          "presentation": { "mode": "dialog", "size": "lg" }
        }
      ]
    }
  ]
}
